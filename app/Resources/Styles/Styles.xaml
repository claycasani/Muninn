<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ============================================================
         MUNINN DESIGN SYSTEM — Styles.xaml
         your memory, returned

         Source of truth: STYLEGUIDE.md
         Do not hardcode any color, size, or radius in page XAML.
         Always reference a named resource from this file.
         ============================================================ -->


    <!-- ============================================================
         COLORS — Core palette
         ============================================================ -->

    <!-- Backgrounds -->
    <Color x:Key="ColorBackground">#FAFAF8</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSunken">#F2F2EF</Color>

    <!-- Text -->
    <Color x:Key="ColorTextPrimary">#1A1A1A</Color>
    <Color x:Key="ColorTextSecondary">#8E8E93</Color>
    <Color x:Key="ColorTextTertiary">#C2C2C6</Color>

    <!-- Separator — use sparingly, only where spacing alone is insufficient -->
    <Color x:Key="ColorSeparator">#E5E5EA</Color>

    <!-- Accent — deep olive #444A2E -->
    <!-- Solid: primary buttons, completed checkmarks, active tab icons only -->
    <Color x:Key="ColorAccent">#444A2E</Color>
    <!-- Tint: category tags, selected states, secondary buttons (12% opacity) -->
    <Color x:Key="ColorAccentTintBg">#1F444A2E</Color>
    <!-- Text on tinted surfaces -->
    <Color x:Key="ColorAccentTintText">#444A2E</Color>

    <!-- Translucent chrome mimic for MAUI content-level controls -->
    <Color x:Key="ColorGlassChrome">#EEFFFFFF</Color>
    <Color x:Key="ColorGlassStroke">#D9E5E5EA</Color>
    <Color x:Key="ColorGlassActiveOverlay">#14000000</Color>
    <Color x:Key="ColorGlassShadow">#18000000</Color>

    <!-- Destructive actions -->
    <Color x:Key="ColorDestructive">#FF3B30</Color>
    <Color x:Key="ColorDestructiveTintBg">#1FFF3B30</Color>
    <Color x:Key="ColorModalScrim">#33000000</Color>
    <Color x:Key="ColorImagePreviewBackdrop">#F20D0D0D</Color>

    <!-- Settings icon badge colors -->
    <Color x:Key="ColorIconOrange">#FF9500</Color>
    <Color x:Key="ColorIconGray">#8E8E93</Color>
    <Color x:Key="ColorIconRed">#FF3B30</Color>
    <Color x:Key="ColorIconGreen">#34C759</Color>
    <Color x:Key="ColorIconTeal">#30B0C7</Color>
    <Color x:Key="ColorIconPurple">#5E5CE6</Color>


    <!-- ============================================================
         SPACING — 8pt base grid
         ============================================================ -->

    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceSM">8</x:Double>
    <x:Double x:Key="SpaceMD">16</x:Double>
    <x:Double x:Key="SpaceLG">24</x:Double>
    <x:Double x:Key="SpaceXL">32</x:Double>
    <x:Double x:Key="SpaceXXL">48</x:Double>

    <!-- Screen horizontal margin — apply to page content containers -->
    <Thickness x:Key="ScreenMargin">24,0,24,0</Thickness>
    <!-- Card internal padding -->
    <Thickness x:Key="CardPadding">16,16,16,16</Thickness>
    <!-- Button internal padding -->
    <Thickness x:Key="ButtonPadding">16,0,16,0</Thickness>
    <!-- Compact settings row padding -->
    <Thickness x:Key="SettingsRowPadding">16,10,16,10</Thickness>


    <!-- ============================================================
         CORNER RADII
         ============================================================ -->

    <x:Double x:Key="CornerRadiusCard">16</x:Double>
    <x:Double x:Key="CornerRadiusButton">14</x:Double>
    <x:Double x:Key="CornerRadiusInput">12</x:Double>
    <x:Double x:Key="CornerRadiusTag">20</x:Double>
    <x:Double x:Key="CornerRadiusFavicon">10</x:Double>
    <x:Double x:Key="CornerRadiusBanner">12</x:Double>


    <!-- ============================================================
         TYPOGRAPHY — SF Pro via system font stack
         MAUI renders real SF Pro on iOS/macOS automatically.
         ============================================================ -->

    <!-- Sizes -->
    <x:Double x:Key="FontSizeTitle">28</x:Double>
    <x:Double x:Key="FontSizeBody">17</x:Double>
    <x:Double x:Key="FontSizeSecondary">13</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>

    <!-- Screen titles: Inbox, Today's Digest, Muninn wordmark -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
    </Style>

    <!-- Card titles, body content -->
    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <!-- Card titles bold variant -->
    <Style x:Key="BodyBoldLabel" TargetType="Label" BasedOn="{StaticResource BodyLabel}">
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Timestamps, domains, AI reason lines, tag text -->
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
    </Style>

    <!-- Placeholder, disabled text, completed-state titles -->
    <Style x:Key="TertiaryLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextTertiary}" />
    </Style>

    <!-- Auth tagline: "your memory, returned" -->
    <Style x:Key="TaglineLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>


    <!-- ============================================================
         BUTTONS
         ============================================================ -->

    <!-- Primary: full-width, solid olive, white text -->
    <Style x:Key="ButtonPrimary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    </Style>

    <!-- Secondary: olive tint background, olive text -->
    <Style x:Key="ButtonSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccentTintBg}" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccentTintText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    </Style>

    <!-- Plain: transparent, olive text, no border -->
    <Style x:Key="ButtonPlain" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccentTintText}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="HeightRequest" Value="44" />
    </Style>

    <!-- Destructive: solid system red for irreversible actions -->
    <Style x:Key="ButtonDestructive" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorDestructive}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    </Style>

    <!-- Neutral filled button for cancel-style actions -->
    <Style x:Key="ButtonNeutral" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSunken}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    </Style>


    <!-- ============================================================
         INPUT FIELDS
         ============================================================ -->

    <Style x:Key="InputEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource ColorTextTertiary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Border wrapper for Entry — use a Border control wrapping the Entry -->
    <Style x:Key="InputBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource ColorSeparator}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
    </Style>


    <!-- ============================================================
         CARDS
         ============================================================ -->

    <!-- Save card outer border/container -->
    <Style x:Key="SaveCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Category tag -->
    <Style x:Key="CategoryTag" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorAccentTintBg}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="CategoryTagLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccentTintText}" />
    </Style>

    <!-- Inbox category filter chips -->
    <Style x:Key="FilterChip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="MinimumWidthRequest" Value="52" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="FilterChipLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <!-- Favicon/monogram container -->
    <Style x:Key="FaviconContainer" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSunken}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style x:Key="FaviconMonogram" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>


    <!-- ============================================================
         SETTINGS / ACCOUNT
         ============================================================ -->

    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SettingsRowTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="SettingsRowValue" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="SettingsChevron" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextTertiary}" />
        <Setter Property="Text" Value="›" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>

    <Style x:Key="SettingsIconLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SettingsIconImage" TargetType="Image">
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="SettingsGlassButton" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorGlassChrome}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource ColorGlassStroke}" />
        <Setter Property="StrokeShape" Value="Ellipse" />
        <Setter Property="WidthRequest" Value="50" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Shadow">
            <Shadow
                Brush="#18000000"
                Offset="0,8"
                Radius="18"
                Opacity="0.16" />
        </Setter>
    </Style>

    <Style x:Key="HeaderChromeIcon" TargetType="Image">
        <Setter Property="WidthRequest" Value="22" />
        <Setter Property="HeightRequest" Value="22" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="FloatingChromeButton" TargetType="Border" BasedOn="{StaticResource SettingsGlassButton}">
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="GlassTabBarFallback" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorGlassChrome}" />
        <Setter Property="Stroke" Value="{StaticResource ColorGlassStroke}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 34" />
        <Setter Property="Shadow">
            <Shadow
                Brush="{StaticResource ColorGlassShadow}"
                Offset="0,8"
                Radius="18"
                Opacity="0.16" />
        </Setter>
    </Style>

    <Style x:Key="BottomSheetCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSurface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="24,16,24,24" />
    </Style>

    <Style x:Key="AvatarLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorAccent}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>


    <!-- ============================================================
         DIGEST URGENCY BANNERS
         ============================================================ -->

    <Style x:Key="UrgencyBanner" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorSunken}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="UrgencyBannerLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
    </Style>


    <!-- ============================================================
         EMPTY STATES
         ============================================================ -->

    <Style x:Key="EmptyStateTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextPrimary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateBody" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>


    <!-- ============================================================
         PAGE LAYOUT
         ============================================================ -->

    <!-- Apply to the root ContentPage background -->
    <Style x:Key="AppPage" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource ColorBackground}" />
    </Style>

    <!-- Section header labels -->
    <Style x:Key="SectionHeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource ColorTextSecondary}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

</ResourceDictionary>
