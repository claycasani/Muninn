<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Muninn.Views.DigestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Muninn.Controls"
    xmlns:models="clr-namespace:Muninn.Models"
    xmlns:vm="clr-namespace:Muninn.ViewModels"
    Style="{StaticResource AppPage}"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="None"
    Title="Today's Digest">

    <Grid RowDefinitions="Auto,*">
        <!-- Bottom margin gives breathing room between the date line and the
             scrolling card area below (cards otherwise start flush under it). -->
        <VerticalStackLayout
            Grid.Row="0"
            Margin="24,32,24,12"
            Spacing="4">
            <Label
                Text="Today's Digest"
                Style="{StaticResource TitleLabel}" />
            <Label
                Style="{StaticResource SecondaryLabel}"
                Text="{Binding DateSubtitle}" />
        </VerticalStackLayout>

        <!-- Loading indicator -->
        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            Color="{StaticResource ColorAccent}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

        <!-- Recent saves resurfaced as today's digest -->
        <CollectionView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never"
            ItemsSource="{Binding Saves}"
            IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
            Margin="24,0,24,-44">

            <CollectionView.Header>
                <BoxView HeightRequest="{StaticResource SpaceMD}" Color="Transparent" />
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SaveModel">
                    <Border
                        Style="{StaticResource SaveCard}"
                        Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DigestViewModel}}, Path=NavigateToDetailCommand}"
                                CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>

                        <!-- Same layout as the Inbox save card, minus the complete circle:
                             digest cards link to Save Detail rather than completing inline. -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">

                            <!-- Favicon / thumbnail slot (spans all rows on left) -->
                            <Border
                                Grid.Column="0"
                                Grid.RowSpan="4"
                                Style="{StaticResource FaviconContainer}"
                                VerticalOptions="Start">
                                <Grid>
                                    <Label
                                        Style="{StaticResource FaviconMonogram}"
                                        Text="{Binding Monogram}" />
                                    <Image
                                        Source="{Binding FaviconUrl}"
                                        Aspect="AspectFit"
                                        IsVisible="{Binding FaviconUrl, Converter={StaticResource NullToBoolConverter}}" />
                                    <Image
                                        Source="{Binding ImageUrl}"
                                        Aspect="AspectFill"
                                        IsVisible="{Binding ImageUrl, Converter={StaticResource NullToBoolConverter}}" />
                                </Grid>
                            </Border>

                            <!-- Row 0: domain/"Screenshot" + timestamp -->
                            <Label
                                Grid.Column="1"
                                Grid.Row="0"
                                Style="{StaticResource SecondaryLabel}"
                                Text="{Binding MetaLabel}" />
                            <Label
                                Grid.Column="1"
                                Grid.Row="0"
                                Style="{StaticResource SecondaryLabel}"
                                HorizontalOptions="End"
                                Text="{Binding RelativeTime}" />

                            <!-- Row 1: title -->
                            <Label
                                Grid.Column="1"
                                Grid.Row="1"
                                Style="{StaticResource BodyBoldLabel}"
                                Text="{Binding DisplayTitle}"
                                Margin="0,2,0,2" />

                            <!-- Row 2: AI reason line (hidden when null). Width-constrained
                                 Label so the reason wraps instead of clipping at the edge. -->
                            <Label
                                Grid.Column="1"
                                Grid.Row="2"
                                Style="{StaticResource SecondaryLabel}"
                                LineBreakMode="WordWrap"
                                MaxLines="2"
                                IsVisible="{Binding AiReason, Converter={StaticResource StringNotEmptyConverter}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="✦ " />
                                        <Span Text="{Binding AiReason}" FontAttributes="Italic" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Analyzing placeholder shown when no AI reason yet -->
                            <Label
                                Grid.Column="1"
                                Grid.Row="2"
                                Style="{StaticResource TertiaryLabel}"
                                Text="Analyzing…"
                                IsVisible="{Binding AiReason, Converter={StaticResource StringEmptyConverter}}" />

                            <!-- Row 3: category tag -->
                            <Border
                                Grid.Column="1"
                                Grid.Row="3"
                                Style="{StaticResource CategoryTag}"
                                HorizontalOptions="Start"
                                Margin="0,4,0,0">
                                <Label
                                    Style="{StaticResource CategoryTagLabel}"
                                    Text="{Binding Category, StringFormat='• {0}'}" />
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <!-- Clears the floating glass tab bar -->
                <BoxView HeightRequest="120" Color="Transparent" />
            </CollectionView.Footer>

        </CollectionView>

        <!-- Empty state as a page-level overlay, NOT CollectionView.EmptyView (MAUI
             positions the EmptyView after the measured header, rendering it low on
             the screen — same fix as InboxPage). -->
        <VerticalStackLayout
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsEmptyStateVisible}"
            InputTransparent="True"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="{StaticResource SpaceSM}">
            <Label
                Text="✦"
                FontSize="44"
                HorizontalOptions="Center"
                TextColor="{StaticResource ColorTextSecondary}" />
            <Label
                Style="{StaticResource EmptyStateTitle}"
                Text="You're all caught up" />
            <Label
                Style="{StaticResource EmptyStateBody}"
                Text="Check back tomorrow." />
        </VerticalStackLayout>

        <!-- Custom floating glass tab bar (content scrolls behind it) -->
        <controls:GlassTabBar Grid.RowSpan="2" Current="Digest" />

    </Grid>

</ContentPage>
