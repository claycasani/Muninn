<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Muninn.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Muninn.Controls"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    Style="{StaticResource AppPage}"
    Shell.NavBarIsVisible="False"
    Title="Change Password">

    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource ScreenMargin}">

        <controls:GlassNavHeader Grid.Row="0" Title="Change Password" Margin="0,16,0,4" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">
                <BoxView HeightRequest="{StaticResource SpaceMD}" Color="Transparent" />

                <Border Style="{StaticResource SettingsCard}">
                    <VerticalStackLayout Spacing="0" Padding="{StaticResource CardPadding}">
                        <Label Style="{StaticResource SecondaryLabel}" Text="Current Password" />
                        <Entry
                            Style="{StaticResource InputEntry}"
                            IsPassword="True"
                            Text="{Binding CurrentPassword}" />

                        <BoxView HeightRequest="1" Color="{StaticResource ColorSeparator}" />

                        <Label Style="{StaticResource SecondaryLabel}" Text="New Password" Margin="0,16,0,0" />
                        <Entry
                            Style="{StaticResource InputEntry}"
                            IsPassword="True"
                            Placeholder="Required"
                            Text="{Binding NewPassword}" />

                        <BoxView HeightRequest="1" Color="{StaticResource ColorSeparator}" />

                        <Label Style="{StaticResource SecondaryLabel}" Text="Confirm New Password" Margin="0,16,0,0" />
                        <Entry
                            Style="{StaticResource InputEntry}"
                            IsPassword="True"
                            Placeholder="Required"
                            Text="{Binding ConfirmPassword}" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Style="{StaticResource SecondaryLabel}"
                    Margin="6,12,6,0"
                    Text="Use at least 8 characters, including a number and a symbol." />

                <Label
                    Style="{StaticResource SecondaryLabel}"
                    TextColor="{StaticResource ColorDestructive}"
                    Text="{Binding ErrorMessage}"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="6,12,6,0" />

                <Label
                    Style="{StaticResource SecondaryLabel}"
                    TextColor="{StaticResource ColorAccent}"
                    Text="{Binding SuccessMessage}"
                    IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}"
                    Margin="6,12,6,0" />
            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="2"
            Style="{StaticResource ButtonPrimary}"
            Text="Save Password"
            Command="{Binding SavePasswordCommand}"
            IsEnabled="{Binding SavePasswordCommand.IsRunning, Converter={StaticResource InverseBoolConverter}}"
            Margin="0,0,0,24" />
    </Grid>
</ContentPage>
