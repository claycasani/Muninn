<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Muninn.Converters"
             x:Class="Muninn.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:StringEmptyConverter x:Key="StringEmptyConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:BoolToStrikethroughConverter x:Key="BoolToStrikethroughConverter" />
            <converters:BoolToTertiaryColorConverter x:Key="BoolToTertiaryColorConverter" />
            <converters:BoolToAccentSeparatorConverter x:Key="BoolToAccentSeparatorConverter" />
            <converters:BoolToAccentTransparentConverter x:Key="BoolToAccentTransparentConverter" />
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:NullToBoolInvertedConverter x:Key="NullToBoolInvertedConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
