# Muninn backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Gemini Developer API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# JWT signing key — must be at least 32 characters, random
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Local Postgres (used by docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mnemosyne
SPRING_DATASOURCE_USERNAME=mnemosyne
SPRING_DATASOURCE_PASSWORD=moneta

# Optional local SQL logging (disabled by default, including in production)
SHOW_SQL=false

# Production only (Render + Neon): use Neon's DIRECT, non-pooler JDBC endpoint and include sslmode=require.
# DATABASE_URL=jdbc:postgresql://your-neon-direct-host.neon.tech/your-db?sslmode=require
# DB_USERNAME=your-neon-user
# DB_PASSWORD=your-neon-password

# Cloudflare R2 object storage (for image saves)
# Account ID is in the R2 dashboard URL: dash.cloudflare.com/<account-id>/r2
# Create an API token at R2 > Manage R2 API Tokens with Object Read & Write permissions
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=muninn-saves
