# Muninn backend environment variables
# Copy this file to backend/.env and fill in local values.
# NEVER commit .env to version control.

# Optional: a personal Gemini API key enables AI analysis.
GEMINI_API_KEY=

# JWT signing key — must be at least 32 characters, random
JWT_SECRET=

# Local Postgres (used by docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mnemosyne
SPRING_DATASOURCE_USERNAME=mnemosyne
SPRING_DATASOURCE_PASSWORD=moneta

# Optional local SQL logging (disabled by default, including in production)
SHOW_SQL=false

# Optional: your own Cloudflare R2 bucket and keys enable image saves.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
